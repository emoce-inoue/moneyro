{
  "name": "markup-base",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "prettier --config config/.prettierrc --write '**/*.{js,css,html}'",
    "format:check": "prettier --config config/.prettierrc --check '**/*.{js,css,html}'",
    "lint:html": "htmlhint --config config/.htmlhintrc '**/*.html'",
    "lint:js": "eslint --config config/eslint.config.js '**/*.js'",
    "lint:js:fix": "eslint --config config/eslint.config.js --fix '**/*.js'",
    "lint:css": "stylelint --config config/stylelint.config.js --ignore-path config/stylelintignore '**/*.css'",
    "lint:css:fix": "stylelint --config config/stylelint.config.js --ignore-path config/stylelintignore '**/*.css' --fix",
    "check": "npm run format && npm run lint:js && npm run lint:css && npm run lint:html",
    "start": "webpack serve --mode development",
    "build": "webpack --mode production"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@eslint/js": "^10.0.1",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "cssnano": "^7.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "html-webpack-plugin": "^5.6.0",
    "htmlhint": "^1.1.4",
    "mini-css-extract-plugin": "^2.9.1",
    "postcss": "^8.4.45",
    "postcss-loader": "^8.1.1",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "stylelint": "^16.9.0",
    "stylelint-config-standard": "^36.0.1",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  }
}
